# ============================================================
# Swan Turbines Foundation — Backend Environment Variables
# Copy to .env and fill in values for local development.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- MongoDB ---
# Local development: mongodb://localhost:27017
# Production: MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=swanfoundation_dev

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-replace-with-random-hex-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# --- Email (Resend) ---
# Get API key from https://resend.com
# Development: use sandbox from address (onboarding@resend.dev)
# Production: use your verified domain
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=onboarding@resend.dev

# --- Admin notifications ---
# Email address that receives notifications about new help requests
ADMIN_NOTIFICATION_EMAIL=aruna@swanturbinesfoundation.com

# --- Frontend URLs ---
# Used for CORS and email links
PUBLIC_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000/admin
MANAGE_FRONTEND_URL=http://localhost:3000/manage

# --- File uploads ---
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/gif
